# ==============================================================================
# LabStock Environment Configuration Template
# ==============================================================================
# Security Notice: Never commit .env with real credentials or secrets to Git.

# Application Environment (development, testing, production)
ENVIRONMENT=development
PROJECT_NAME="LabStock Laboratory Inventory"
API_V1_STR=/api/v1

# Security & Authentication (Generate secure 64+ char secret for production)
SECRET_KEY=labstock_super_secret_jwt_signing_key_replace_for_production_min_64_chars_len
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Connection
# SQLite (Local Development default):
DATABASE_URL=sqlite:///./labstock.db
# PostgreSQL (Production / Shared):
# DATABASE_URL=postgresql+psycopg2://labstock_user:secure_password@localhost:5432/labstock_db

# CORS Allowed Origins (JSON array)
CORS_ORIGINS=["http://localhost:8000","http://localhost:8550","http://127.0.0.1:8000","http://127.0.0.1:8550"]

# Frontend Configuration
FRONTEND_API_BASE_URL=http://127.0.0.1:8000

# Rate Limiting & Security Defaults
LOGIN_RATE_LIMIT_PER_MINUTE=10
IDEMPOTENCY_CACHE_TTL_HOURS=24
